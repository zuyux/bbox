# Network configuration - TESTNET
NEXT_PUBLIC_STACKS_NETWORK=mainnet
PLATFORM_API_DOMAIN=https://api.testnet.hiro.so
NEXT_PUBLIC_DEPLOYER_ACCOUNT_ADDRESS=your_deployer_account_address_here
NEXT_PUBLIC_ADMIN_ADDRESS=your_admin_address_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# Public anon key for browser usage
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here
# Service role key for server-side usage only (DO NOT expose publicly)
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here
# Alias also supported by scripts and deployments:
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# Random server-only secret used to HMAC visitor IPs (for example: openssl rand -hex 32)
IP_HASH_SECRET=your_random_64_character_secret_here

# Pinata
PINATA_GATEWAY_URL=https://ipfs.io
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://ipfs.io
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_here

# Additional Pinata variables for compatibility
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_API_KEY=your_pinata_secret_key_here

# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_HIRO_API_KEY=your_platform_hiro_api_key_here

# GitHub App OAuth
# Configure the GitHub App callback URL as:
# ${NEXT_PUBLIC_BASE_URL}/api/github/callback
GITHUB_CLIENT_ID=your_github_app_client_id_here
GITHUB_CLIENT_SECRET=your_github_app_client_secret_here

# VERCEL BLOB STORAGE
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here
# Exact hostname assigned to this Blob store, without protocol or path.
VERCEL_BLOB_ALLOWED_HOSTNAME=your-store.public.blob.vercel-storage.com

RESEND_API_KEY=your_resend_api_key_here
# Use a verified Resend sender, for example: BBOXX <noreply@bboxx.app>
RESEND_FROM_EMAIL=your_resend_from_email_here
# Recipient for new-account and wallet sign-in alerts (defaults to 40230@pm.me)
ACCOUNT_ACTIVITY_NOTIFICATION_EMAIL=user@domain
# Optional: where footer subscribe notifications are sent.
SUBSCRIBE_NOTIFY_EMAIL=fabohax@gmail.com

# WalletConnect Auth
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Bitflow SDK. Browser requests go through BBOXX's same-origin API proxy to avoid
# upstream CORS restrictions. Set the provider address supplied for BBOXX.
NEXT_PUBLIC_BITFLOW_PROVIDER_ADDRESS=
BITFLOW_API_HOST=https://bitflow-sdk-api-gateway-7owjsmt8.uc.gateway.dev
READONLY_CALL_API_HOST=https://node.bitflowapis.finance
KEEPER_API_HOST=https://bitflow-keeper-test-7owjsmt8.uc.gateway.dev

# Optional Bitflow keys for higher rate limits. Keep these server-side.
BITFLOW_API_KEY=
READONLY_CALL_API_KEY=
KEEPER_API_KEY=

# Optional: server-side BAR inscription relay for passkey-authorized Bitcoin L1 inscriptions.
# Extension wallets can use the client-side inscription flow without these values.
BAR_INSCRIPTION_ENDPOINT=
BAR_INSCRIPTION_API_KEY=

IP_HASH_SECRET=
