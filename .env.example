# Network configuration - TESTNET
NEXT_PUBLIC_STACKS_NETWORK=mainnet
PLATFORM_API_DOMAIN=https://api.testnet.hiro.so
NEXT_PUBLIC_DEPLOYER_ACCOUNT_ADDRESS=your_deployer_account_address_here

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url_here
# Public anon key for browser usage
NEXT_PUBLIC_SUPABASE_KEY=your_supabase_anon_key_here
# Service role key for server-side usage only (DO NOT expose publicly)
SUPABASE_SECRET_KEY=your_supabase_service_role_key_here

# Pinata
PINATA_GATEWAY_URL=https://ipfs.io
NEXT_PUBLIC_PINATA_GATEWAY_URL=https://ipfs.io
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_KEY=your_pinata_secret_key_here
PINATA_JWT=your_pinata_jwt_here

# Additional Pinata variables for compatibility
NEXT_PUBLIC_PINATA_API_KEY=your_pinata_api_key_here
NEXT_PUBLIC_PINATA_SECRET_API_KEY=your_pinata_secret_key_here


# App
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_PLATFORM_HIRO_API_KEY=your_platform_hiro_api_key_here

# VERCEL BLOB STORAGE
BLOB_READ_WRITE_TOKEN=your_vercel_blob_token_here

RESEND_API_KEY=your_resend_api_key_here
# VERIFICAR
RESEND_FROM_EMAIL=your_resend_from_email_here
